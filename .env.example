# NestPad Tenancy Management — Environment Variables Template
# Copy this to .env for local testing, or add to your Vercel Project Settings > Environment Variables

# Cloud MySQL Database Configuration (e.g., TiDB Cloud, Aiven, PlanetScale, Railway, Supabase)
MYSQL_HOST=your-db-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=nestpad_db
MYSQL_SSL=true

# Optional: active database engine ('mysql' or 'sqlite')
ACTIVE_DATABASE=mysql
